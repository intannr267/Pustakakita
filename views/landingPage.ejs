<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pustakakita</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600&family=Poppins:wght@400;600&display=swap"
    rel="stylesheet">
  <style>
    .font-orbitron {
      font-family: 'Orbitron', sans-serif;
    }

    .font-poppins {
      font-family: 'Poppins', sans-serif;
    }

    .hero-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
    }

    .hero-overlay {
      background: rgba(0, 0, 0, 0.5);
    }

    .mobile-menu {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }

    .mobile-menu.open {
      max-height: 500px;
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.7);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(234, 179, 8, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(234, 179, 8, 0);
      }
    }
  </style>
</head>

<body class="font-poppins overflow-x-hidden">

  <%- include('./partials/nav') %>

  <% if (err) { %>
    <script>
      alert("<%= err %>");
    </script>
  <% } %>

  <!-- Hero Section -->
  <section class="relative h-[60vh] flex items-center justify-center overflow-hidden">
    <img src="https://images.unsplash.com/photo-1722182877533-7378b60bf1e8?w=1000&auto=format&fit=crop&q=60"
      alt="Library Background" class="absolute inset-0 w-full h-full object-cover z-0" />
    <div class="absolute inset-0 bg-black bg-opacity-50 z-0"></div>
    <div class="relative z-10 text-center text-white px-4">
      <h1 class="text-4xl font-orbitron font-bold drop-shadow-lg">WELCOME TO PUSTAKAKITA</h1>
      <p class="mt-4 text-xl drop-shadow-md">Rent. Chill. Read. Repeat.</p>
      <a href="/books"
        class="mt-6 inline-block bg-yellow-900 hover:bg-yellow-800 text-white px-6 py-4 rounded-lg transition duration-300">
        Show More
      </a>
    </div>
  </section>

  <!-- Featured Categories -->
  <section id="featured" class="py-20 bg-gray-100 md:px-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-4xl font-bold text-gray-800 mb-4">Book's Category</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card: Fiction -->
        <div
          class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition duration-300 transform hover:-translate-y-2">
          <div class="relative">
            <img src="https://www.book-editing.com/wp-content/uploads/2018/08/fiction-nonfiction-1024x682.jpg"
              alt="Fiction" class="w-full h-64 object-cover">
            <div
              class="absolute top-4 right-4 bg-red-500 text-white text-sm font-bold px-3 py-1 rounded-full">
              Most Popular
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800">Fiction</h3>
          </div>
        </div>

        <!-- Card: Business -->
        <div
          class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition duration-300 transform hover:-translate-y-2">
          <div class="relative">
            <img src="https://imageio.forbes.com/specials-images/imageserve/5fca87f3ce4ca55e8985a10a/0x0.jpg?format=jpg&height=900&width=1600&fit=bounds"
              alt="Business" class="w-full h-64 object-cover">
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800">Business</h3>
          </div>
        </div>

        <!-- Card: Programming -->
        <div
          class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition duration-300 transform hover:-translate-y-2">
          <div class="relative">
            <img src="https://i0.wp.com/garonpower.com/wp-content/uploads/2019/01/computer-programming.jpeg?fit=1500%2C1000&ssl=1"
              alt="Programming" class="w-full h-64 object-cover">
            <div
              class="absolute top-4 right-4 bg-red-500 text-white text-sm font-bold px-3 py-1 rounded-full">
              Most Popular
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800">Programming</h3>
          </div>
        </div>
      </div>

      <div class="w-full flex justify-center mt-12">
        <button
          class="bg-yellow-900 hover:bg-yellow-800 text-white text-sm font-medium py-4 px-10 rounded-full transition-all duration-300 shadow">
          View All Books
        </button>
      </div>
    </div>
  </section>

  <!-- How it Works -->
  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">How it Works</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Step 1 -->
        <div class="text-center p-6 rounded-lg hover:bg-gray-50 transition">
          <div class="w-20 h-20 bg-yellow-900 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-search text-yellow-100 text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">1. Choose Your Book</h3>
          <p class="text-gray-600">Browse through our collection and select your favorite books.</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center p-6 rounded-lg hover:bg-gray-50 transition">
          <div class="w-20 h-20 bg-yellow-900 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-credit-card text-yellow-100 text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">2. Place Your Book Order</h3>
          <p class="text-gray-600">Choose your favorite titles and start your reading journey today.</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center p-6 rounded-lg hover:bg-gray-50 transition">
          <div class="w-20 h-20 bg-yellow-900 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-book text-yellow-100 text-3xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">3. Enjoy Your Book</h3>
          <p class="text-gray-600">Receive your book quickly and enjoy your reading journey without hassle.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="py-20 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">What Our Customers Say</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Hear from people who have enjoyed our services</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Testimonial 1 -->
        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="flex items-center mb-4">
            <div class="flex items-center text-yellow-400 mr-2">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
            </div>
            <span class="text-gray-600 text-sm">5.0</span>
          </div>
          <p class="text-gray-700 mb-6">"Simpel banget mau pinjem buku gak pake adu bacok sama orang"</p>
          <div class="flex items-center">
            <img src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD/..." alt="Sarah J."
              class="w-12 h-12 rounded-full mr-4">
            <div>
              <h4 class="font-bold text-gray-800">Siti Alexandra</h4>
              <p class="text-gray-600 text-sm">Pelajar</p>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="flex items-center mb-4">
            <div class="flex items-center text-yellow-400 mr-2">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star-half-alt"></i>
            </div>
            <span class="text-gray-600 text-sm">4.5</span>
          </div>
          <p class="text-gray-700 mb-6">"Sumpah enak banget mau pinjem buku ga perlu keliling cari stock bukunya"</p>
          <div class="flex items-center">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ-u_5dIgbdD92gp1LYDnvajVcFejZis651WA&s" alt="Michael T."
              class="w-12 h-12 rounded-full mr-4">
            <div>
              <h4 class="font-bold text-gray-800">Michael Joko</h4>
              <p class="text-gray-600 text-sm">Mahasiswa</p>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="flex items-center mb-4">
            <div class="flex items-center text-yellow-400 mr-2">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
            </div>
            <span class="text-gray-600 text-sm">5.0</span>
          </div>
          <p class="text-gray-700 mb-6">"Mudah banget cari buku-buku favoritku, puas!"</p>
          <div class="flex items-center">
            <img src="https://i.ibb.co/58DcmNr/avatar.png" alt="Emily R."
              class="w-12 h-12 rounded-full mr-4">
            <div>
              <h4 class="font-bold text-gray-800">Lia Ramadhani</h4>
              <p class="text-gray-600 text-sm">Pelajar</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('./partials/footer') %>

</body>

</html>
