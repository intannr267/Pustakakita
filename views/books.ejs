<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>PustakaKita - Book Collection</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans bg-gradient-to-br from-yellow-50 to-gray-100 min-h-screen flex flex-col">
    <!-- Navbar -->
    <%- include('./partials/nav') %>

    <main class="flex-grow px-6 py-16">
      <!-- Title -->
      <h1 class="text-4xl font-extrabold text-center mb-10 text-yellow-900 tracking-wide">
        Book Collection
      </h1>

      <!-- Search + Invoice -->
      <div class="max-w-lg mx-auto mb-10">
        <form
          action="/books"
          method="GET"
          class="flex shadow-lg rounded-xl overflow-hidden bg-white border border-yellow-200"
        >
          <input
            type="text"
            name="title"
            id="title"
            placeholder=" Search by title..."
            class="flex-grow px-4 py-3 text-brown-900 focus:outline-none focus:ring-2 focus:ring-yellow-700"
          />
          <button
            type="submit"
            class="bg-yellow-800 text-white px-5 py-3 hover:bg-yellow-700 transition font-medium"
          >
            Search
          </button>
        </form>

        <% if (trigger) { %>
        <div class="text-center mt-6">
          <a
            href="/generate-invoice"
            class="inline-block bg-yellow-700 text-white px-5 py-3 rounded-lg shadow hover:bg-yellow-600 transition font-semibold"
          >
             Generate Invoice
          </a>
        </div>
        <% } %>
      </div>

      <!-- Book Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8"
      >
        <% books.forEach(book=> { %>
        <div
          class="bg-white border border-yellow-200 rounded-2xl shadow-md hover:shadow-xl transform hover:-translate-y-1 transition duration-300"
        >
          <img
            src="<%= book.imageURL %>"
            alt="<%= book.title %>"
            class="w-full h-64 object-cover rounded-t-2xl"
          />
          <div class="p-5">
            <h2 class="text-xl font-bold text-yellow-900 mb-2 line-clamp-1">
              <%= book.title %>
            </h2>
            <p class="text-sm text-gray-600 mb-1">
              <span class="font-semibold">Publisher:</span> <%= book.publisher %>
            </p>
            <p class="text-sm text-gray-600 mb-1">
              <span class="font-semibold">Pages:</span> <%= book.pageCount %>
            </p>
            <p class="text-xs text-gray-500 mt-2">ISBN: <%= book.isbn %></p>

            <!-- Buttons -->
            <div class="flex flex-wrap gap-2 mt-4 justify-center">
              <!-- Details -->
              <a
                href="/books/<%= book.id %>"
                class="w-[90px] text-center bg-yellow-700 text-white px-3 py-2 text-sm rounded-lg hover:bg-yellow-600 transition"
              >
                Details
              </a>

              <!-- Out of Stock -->
              <% if (!book.isAvailable) { %>
              <span
                class="text-red-600 text-sm font-semibold w-[90px] text-center py-2"
              >
                Out of Stock
              </span>
              <% } %>

              <!-- Borrow -->
              <% if (book.isAvailable) { %>
              <a
                href="/books/<%= book.id %>/borrow"
                class="w-[90px] text-center bg-green-600 text-white px-3 py-2 text-sm rounded-lg hover:bg-green-500 transition"
              >
                Borrow
              </a>

              <!-- Delete (Admin only) -->
              <% if (role === "admin") { %>
              <form action="/books/<%= book.id %>/delete" method="GET">
                <button
                  type="submit"
                  class="w-[90px] text-center bg-red-600 text-white px-3 py-2 text-sm rounded-lg hover:bg-red-500 transition"
                >
                  Delete
                </button>
              </form>
              <% } %>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
