<!DOCTYPE html>
<html lang="en" class="antialiased">
<head>
  <meta charset="UTF-8" />
  <title><%= book.title %> - Book Detail</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --font-stack: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    html { font-family: var(--font-stack); }
  </style>
</head>

<body class="bg-gradient-to-br from-yellow-50 to-white text-gray-800 min-h-screen flex flex-col">

  <%- include('partials/nav') %>

  <main class="flex-grow container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto bg-white rounded-3xl shadow-2xl p-10 border border-yellow-100">

      <!-- Judul -->
      <h1 class="text-4xl md:text-5xl font-extrabold text-center text-yellow-800 mb-12 tracking-tight leading-tight">
        <%= book.title %>
      </h1>

      <!-- Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        
        <!-- Gambar utama -->
        <div class="relative group overflow-hidden rounded-2xl shadow-lg">
          <img src="<%= book.imageURL %>" alt="Cover of <%= book.title %>" 
               class="w-full h-96 object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>

        <!-- Info Card -->
        <div class="flex justify-center">
          <div class="w-full max-w-md bg-white border border-yellow-100 rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-300">
            
            <!-- Thumbnail -->
            <div class="relative">
              <img src="<%= book.imageURL %>" alt="Thumbnail of <%= book.title %>" 
                   class="w-full h-48 object-cover">
              <div class="absolute top-3 right-3 bg-yellow-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                Featured
              </div>
            </div>

            <!-- Info -->
            <div class="p-6 space-y-4">
              <h2 class="text-2xl font-bold text-yellow-800">
                <%= book.title %>
              </h2>

              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Publisher</span>
                  <span class="font-medium"><%= book.publisher %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Pages</span>
                  <span class="font-medium"><%= book.pageCount %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">ISBN</span>
                  <span class="font-semibold text-yellow-700"><%= book.isbn %></span>
                </div>
              </div>

              <!-- Tombol -->
              <div class="pt-5 flex flex-col sm:flex-row gap-3">
             
               <a href="/books/<%= book.id %>/borrow" 
                  class="flex-1 text-center bg-green-600 text-white px-5 py-3 
                   rounded-xl text-sm font-medium hover:bg-green-700 transition">
                 Borrow
              </a>

                <form action="/books/<%= book.id %>/delete" method="POST" 
                      onsubmit="return confirm('Are you sure you want to delete this book?')" 
                      class="flex-1">
                  <button type="submit"
                          class="w-full bg-red-600 text-white px-5 py-3 rounded-xl text-sm font-medium hover:bg-red-700 transition">
                    Delete
                  </button>
                </form>
              </div>

              <!-- Note -->
              <p class="mt-2 text-xs text-gray-500 text-center">
                Semua aksi bersifat final. Pastikan data sudah benar sebelum menghapus.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
